# Copia este archivo como .env y completa las credenciales que vayas a utilizar.
# Selecciona un solo proveedor por ejecución: none, openai, nim o deepseek.
ANNOTATION_PROVIDER=none

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Usa el UID/GID local para que los archivos creados sean editables por tu usuario.
TRAINING_UID=1000
TRAINING_GID=1000
